{
  "name": "clonecheck",
  "version": "0.1.0",
  "description": "Statically detect imports and references to gitignored or untracked files before commit and CI",
  "type": "module",
  "main": "./src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "clonecheck": "./bin/clonecheck.js"
  },
  "files": [
    "src",
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test test/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/**/*.test.js",
    "prepublishOnly": "npm run build:types"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "git",
    "gitignore",
    "untracked",
    "imports",
    "ci",
    "linter",
    "static-analysis",
    "pre-commit"
  ],
  "author": "Build Agent <build-agent@example.invalid>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codest0411/clonecheck.git"
  },
  "homepage": "https://github.com/codest0411/clonecheck#readme",
  "bugs": {
    "url": "https://github.com/codest0411/clonecheck/issues"
  }
}
